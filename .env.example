# Backend
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/menu-flow
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
PORT=3001
FRONTEND_URL=http://localhost:3000

# Development-only, opt-in initial platform administrator. Never enable in production.
ADMIN_SEED_ENABLED=false
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@menuflow.local
ADMIN_PASSWORD=use-a-unique-development-password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
# Comma-separated trusted HTTPS hosts used by next/image (for example cdn.example.com).
IMAGE_HOSTS=

# Backend-to-backend Rappidex integration. Keep the secret server-side only.
RAPPIDEX_API_URL=https://seu-backend-rappidex.example.com
RAPPIDEX_INTEGRATION_SECRET=replace-with-the-same-long-secret-used-by-rappidex


# OneSignal Web Push. App ID is public; API key must stay only in the backend/Heroku.
ONESIGNAL_APP_ID=2a519701-a888-4d97-90e3-e345d2dd3bea
ONESIGNAL_REST_API_KEY=replace-with-your-onesignal-app-api-key
# Frontend may override these on Vercel. If omitted, the Menu Flow App ID below is used.
NEXT_PUBLIC_ONESIGNAL_APP_ID=2a519701-a888-4d97-90e3-e345d2dd3bea
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=web.onesignal.auto.37a647a2-1bdc-46a8-a505-4f4cc6400a46
