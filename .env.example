# Backend
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/menu-flow
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
PORT=3001
FRONTEND_URL=http://localhost:3000

# Development-only, opt-in initial platform administrator. Never enable in production.
ADMIN_SEED_ENABLED=false
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@menuflow.local
ADMIN_PASSWORD=use-a-unique-development-password

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
# Comma-separated trusted HTTPS hosts used by next/image (for example cdn.example.com).
IMAGE_HOSTS=

# Backend-to-backend Rappidex integration. Keep the secret server-side only.
RAPPIDEX_API_URL=https://seu-backend-rappidex.example.com
RAPPIDEX_INTEGRATION_SECRET=replace-with-the-same-long-secret-used-by-rappidex
