{
  "name": "menu-flow",
  "private": true,
  "workspaces": [
    "Menu-Flow-frontend",
    "Menu-Flow-backend"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "create-super-admin": "npm run create-super-admin --workspace @menu-flow/backend",
    "check:legacy-links": "npm run build --workspace @menu-flow/backend && node Menu-Flow-backend/dist/scripts/check-legacy-user-links.js",
    "migrate:legacy-links": "npm run build --workspace @menu-flow/backend && node Menu-Flow-backend/dist/scripts/migrate-legacy-restaurant-links.js",
    "dev": "npm run dev --workspace @menu-flow/frontend",
    "dev:api": "npm run start:dev --workspace @menu-flow/backend",
    "build": "npm run build --workspace @menu-flow/frontend && npm run build --workspace @menu-flow/backend",
    "lint": "npm run lint --workspace @menu-flow/frontend && npm run lint --workspace @menu-flow/backend",
    "start": "npm run start:prod --workspace @menu-flow/backend",
    "start:prod": "npm run start:prod --workspace @menu-flow/backend",
    "heroku-postbuild": "npm run build --workspace @menu-flow/backend",
    "typecheck": "npm run typecheck --workspace @menu-flow/frontend && npm run typecheck --workspace @menu-flow/backend",
    "seed:test": "node scripts/create-test-users.js",
    "check:integration-contracts": "npm run build --workspace @menu-flow/backend && node Menu-Flow-backend/dist/scripts/migrate-integration-contracts.js",
    "migrate:integration-contracts": "npm run build --workspace @menu-flow/backend && node Menu-Flow-backend/dist/scripts/migrate-integration-contracts.js --apply"
  }
}
